# Kopieren nach .env.production (Build, von Vite gelesen) und/oder als echte
# Umgebungsvariablen in Coolify setzen (server.mjs liest dieselben Namen zur
# Laufzeit aus process.env — src/intern.js). Weder .env.production noch .env
# noch .env.local gehören ins Git (siehe .gitignore).
#
# Strukturierte Firmendaten (Anschrift, Bestell-/Arbeitsschutz-Mail, Nextcloud/
# Update/Paperless-Adresse, Fahrzeug) stehen NICHT hier, sondern in der schon
# bestehenden Mandanten-Datei /data/mandant.json (mandantLaden, src/mandant.js)
# — siehe scripts/mandant/README.md.

VITE_DOLIBARR_URL_DEFAULT=https://dolibarr.example.org
VITE_DOLIBARR_ALT_HOSTS=dolibarr-alt.example.org
VITE_CHAT_UPSTREAM=http://203.0.113.50:8090
VITE_CHAT_HOMESERVER=https://matrix.example.org
VITE_CHAT_SPACE=!example:matrix.example.org
VITE_CHAT_WHATSAPP_SPACE=!example-wa:matrix.example.org
VITE_TELEFON_RAUM=!example-telefon:matrix.example.org
VITE_LKJWT_URL=https://lkjwt.example.org
VITE_UPDATE_BASE=apps.example.org/blattwerk
# Skip-Code des Pflicht-Tutorials (kein Geheimnis, nur eine Hürde gegen
# versehentliches Wegklicken — siehe src/tutorial/uebungen.js).
VITE_TUTORIAL_CODE=00000
# Name des alten privaten Nextcloud-Kalenders (Migrations-Erkennung, muss in
# dolibarr-app.jsx UND server.mjs gleich sein).
VITE_NC_ALTER_KALENDER_NAME=blattwerk_shared_by_max

# Erlaubt Start/Build mit den eingebauten Platzhaltern (Musterstadt/
# example.org) statt echten Betriebsdaten — sonst bricht server.mjs beim
# Start ab, wenn der Mandant Blattwerk (bw) ist und /data/mandant.json fehlt
# oder noch Platzhalter enthält (scripts/mandant/env-pruefen.mjs,
# startPruefen), und vite.config.js verweigert den Production-Build ohne
# VITE_DOLIBARR_URL_DEFAULT. Für Tests/lokale Entwicklung/den öffentlichen
# Export auf "1" setzen, NIE in Coolify/Produktion.
BW_PLATZHALTER_OK=0
