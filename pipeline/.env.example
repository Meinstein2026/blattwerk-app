# Blattwerk Beleg-Pipeline — Konfiguration
# Kopieren nach .env (chmod 600). NC_* am besten via setup_login.py erzeugen.

# Nextcloud — von setup_login.py befüllt
NC_BASE=https://nextcloud.example.org
NC_USER=max
NC_PASS=app-passwort-hier
NC_ROOT=Blattwerk/Belege

# Dolibarr
DOLI_BASE=https://dolibarr-alt.example.org
DOLI_KEY=dolibarr-api-key-hier

# Freigabe-Mail — Versand über den eigenen Stalwart-Mailserver (Dienstkonto
# system@mail.example.org, Passwort auf PH-S3 /root/system-mailer.pw)
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USER=system@mail.example.org
SMTP_PASS=smtp-passwort-hier
MAIL_FROM=system@mail.example.org
MAIL_TO=finanzen@example.org

# App-Scans/manuell angelegte Dolibarr-Entwürfe: Mindestalter in Minuten, bevor
# der Finisher sie per Freigabe-Mail nachreicht (Schonfrist fürs Fertig-Editieren)
APP_DRAFT_MIN_AGE_MIN=30

# Region des Betriebs, taucht im Prüf-Prompt auf (pruefer.py)
BETRIEB_REGION=Ihrer Region

# Optional: Freigabe-Posts zusätzlich in einen Matrix-Raum (Element).
# Bot @belege-bot, Kompatibilitäts-Token via mas-cli auf dem apps-Server;
# alle drei leer lassen = Matrix aus.
MATRIX_URL=https://matrix.example.org
MATRIX_TOKEN=matrix-bot-token-hier
MATRIX_ROOM=!raumid:matrix.example.org
# Link in der Matrix-Caption auf die Freigaben-Seite der App
APP_FREIGABE_URL=https://mobile.example.org/#freigaben

# Freigabe-Server (Links in der Mail; nur LAN/VPN erreichbar)
APPROVE_BASE=http://203.0.113.41:8742
APPROVE_PORT=8742

# Nur für den Worker (Windows-Laptop mit RTX 3060)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
WORKER_INTERVAL=300

# Optional: DNS-Pin für Hotspots, die den Nextcloud-Host mit SERVFAIL
# beantworten (run_pinned.py). Leer/fehlend = kein Pin.
PIN_HOST=nextcloud.example.org
PIN_IP=203.0.113.1

# Optional: Uptime-Ping des Textweg-Smoketests (textweg_smoketest.py)
NTFY_URL=https://ntfy.example.org/homelab-uptime
