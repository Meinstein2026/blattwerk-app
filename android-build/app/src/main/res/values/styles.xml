<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Startbildschirm nach dem Muster der Element-X-Fork: eigenes
         Theme.SplashScreen mit Markenfläche + Icon, danach setzt
         postSplashScreenTheme automatisch auf das App-Theme um. Der Splash
         bleibt stehen, bis die WebView die erste Seite fertig hat
         (setKeepOnScreenCondition), und blendet dann weich aus. -->
    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <!-- Nicht ic_launcher_foreground: der Vordergrund des Adaptive-Icons ist
             der weiße Baum ohne Fläche und verschwände auf dem hellen
             splash_bg. ic_splash ist die fertige Kachel mit eigenem Grund und
             trägt deshalb hell wie dunkel (values-night). -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bw_green_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
